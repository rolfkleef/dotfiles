[user]
	name = Rolf Kleef
	email = rolf@drostan.org

[color]
	ui = true

[alias]
	s = status
	d = diff
	co = checkout
	ci = commit
	cm = commit -m
	l = log --stat -3

[core]
	excludesfile = ~/.config/git/ignore
	attributesfile = ~/.config/git/attributes
	pager = less -FX

[pager]
	log = more

[gui]
	editor = nano

[push]
	default = simple
	followTags = true

[pull]
  rebase = false

[merge]
	summary = true

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[init]
	defaultBranch = main

# if on my laptop, read additional config (fails silently)
[include]
  path = ~/.config/git/config-midgard
